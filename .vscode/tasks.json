{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "configure server",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", ".",
                "-B", "build",
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
                "-DMINIREDIS_BUILD_QT_CONSOLE=OFF",
                "-DCMAKE_CXX_COMPILER=/usr/bin/g++"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "build server",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build",
                "--target", "miniredis",
                "--parallel"
            ],
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": ["configure server"]
        }
    ]
}
